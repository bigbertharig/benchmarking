+static bool durable_write_record(const std::string & directory, durable_record & record, bool commit) {
+    record.header.magic = 0x4b5652455455524eULL;
+    record.header.version = 1;
+    for (int i = 0; i < 2; ++i) {
+        record.header.parts[i].length = record.data[i].size();
+        record.header.parts[i].hash = durable_hash(record.data[i]);
+    }
+    const std::string final = durable_record_path(directory, (int)record.header.turn);
+    const std::string pending = final + ".pending." + std::to_string(::getpid()) + "." +
+        std::to_string(std::chrono::steady_clock::now().time_since_epoch().count());
+    const int fd = ::open(pending.c_str(), O_WRONLY | O_CREAT | O_EXCL, 0600);
+    if (fd < 0) return false;
+    bool ok = durable_write_all(fd, &record.header, sizeof(record.header));
+    if (ok) {
+        for (int i = 0; i < 2; ++i) {
+            const size_t count = commit ? record.data[i].size() : std::min((size_t)4096, record.data[i].size());
+            if (!durable_write_all(fd, record.data[i].data(), count)) { ok = false; break; }
+            if (!commit) break;
+        }
+    }
+    if (ok) ok = ::fsync(fd) == 0;
+    if (::close(fd) != 0) ok = false;
+    if (ok && commit) {
+        ok = ::rename(pending.c_str(), final.c_str()) == 0;
+        if (ok) ok = durable_sync_directory(directory);
+    }
+    if (!ok) std::remove(pending.c_str());
+    return ok;
+}
