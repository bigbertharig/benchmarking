+static bool durable_base_hash(const std::string & path, uint64_t & hash) {
+    FILE * file = std::fopen(path.c_str(), "rb");
+    if (!file) return false;
+    snapshot_header header{};
+    const bool ok = std::fread(&header, sizeof(header), 1, file) == 1 &&
+                    header.magic == 0x4b564348415431ULL;
+    std::fclose(file);
+    if (ok) hash = header.hash;
+    return ok;
+}
