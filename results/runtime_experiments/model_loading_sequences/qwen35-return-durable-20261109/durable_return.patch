+static bool durable_copy_base(const std::string & source, const std::string & directory) {
+    const std::string final = directory + "/base.bin";
+    const std::string pending = final + ".pending." + std::to_string(::getpid()) + "." +
+        std::to_string(std::chrono::steady_clock::now().time_since_epoch().count());
+    std::ifstream input(source, std::ios::binary);
+    if (!input) return false;
+    const int fd = ::open(pending.c_str(), O_WRONLY | O_CREAT | O_EXCL, 0600);
+    if (fd < 0) return false;
+    std::vector<char> buffer(1 << 20);
+    bool ok = true;
+    while (input) {
+        input.read(buffer.data(), buffer.size());
+        const std::streamsize got = input.gcount();
+        if (got > 0 && !durable_write_all(fd, buffer.data(), (size_t)got)) { ok = false; break; }
+    }
+    if (!input.eof()) ok = false;
+    if (ok) ok = ::fsync(fd) == 0;
+    if (::close(fd) != 0) ok = false;
+    if (ok) ok = ::rename(pending.c_str(), final.c_str()) == 0;
+    if (ok) ok = durable_sync_directory(directory);
+    if (!ok) std::remove(pending.c_str());
+    return ok;
+}
