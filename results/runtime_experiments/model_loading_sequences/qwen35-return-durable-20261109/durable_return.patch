+static bool durable_read_record(const std::string & path, int turn, uint64_t base_hash,
+                                uint64_t model_size, int cap, durable_record & record) {
+    FILE * file = std::fopen(path.c_str(), "rb");
+    if (!file) return false;
+    bool ok = std::fread(&record.header, sizeof(record.header), 1, file) == 1;
+    const auto & head = record.header;
+    ok = ok && head.magic == 0x4b5652455455524eULL && head.version == 1 &&
+         head.turn == (uint64_t)turn && head.base_hash == base_hash &&
+         head.model_size == model_size && head.kv_code == 1 && head.cap == (uint64_t)cap;
+    if (ok) {
+        const uint64_t expected = sizeof(head) + head.parts[0].length + head.parts[1].length;
+        ok = head.parts[0].length > 0 && head.parts[0].length < ((uint64_t)1 << 30) &&
+             head.parts[1].length > 0 && head.parts[1].length < ((uint64_t)1 << 30) &&
+             std::filesystem::file_size(path) == expected;
+    }
+    if (ok) {
+        for (int i = 0; i < 2; ++i) {
+            record.data[i].resize(head.parts[i].length);
+            if (std::fread(record.data[i].data(), 1, record.data[i].size(), file) != record.data[i].size()) {
+                std::fprintf(stderr, "DURABLE_REJECT reason=truncated_payload turn=%d part=%d\n", turn, i);
+                ok = false; break;
+            }
+            if (durable_hash(record.data[i]) != head.parts[i].hash) {
+                std::fprintf(stderr, "DURABLE_REJECT reason=checksum turn=%d part=%d\n", turn, i);
+                ok = false; break;
+            }
+        }
+    }
+    if (std::fclose(file) != 0) ok = false;
+    return ok;
+}
