    "state": "ready",
    "timeout_s": 5400,
    "mem_floor_gib": 4,
    "max_host_drop_gb": 26,
    "freeze": true,
    "restart_loaded": true,
    "trace": true
  },
  "cases": [
    {
      "id": "g0_256k_q4kv_ram8",
      "label": "g0 256k q4kv ram8",
      "baseline": "g0_256k_q4kv_ram12",
