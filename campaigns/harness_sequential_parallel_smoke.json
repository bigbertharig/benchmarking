{
  "name": "harness_sequential_parallel_smoke",
  "defaults": {
    "runtime_image": "llama-runtime:b8884-candidate",
    "load_timeout_s": 300,
    "run_class": "smoke"
  },
  "blocks": [
    {
      "id": "knowledge_lane",
      "model": "ministral-3:3b",
      "placement": "single",
      "suite": "bench-knowledge",
      "suite_args": ["--tasks", "academic"],
      "limit": 5,
      "ctx_size": 4096
    },
    {
      "id": "data_parallel_lane",
      "model": "ministral-3:3b",
      "placement": "single",
      "suite": "bench-dataimport",
      "suite_args": ["--tasks", "converter"],
      "limit": 1,
      "ctx_size": 4096
    },
    {
      "id": "geometry_after_knowledge",
      "model": "ministral-3:3b",
      "placement": "single",
      "suite": "bench-geoimport",
      "suite_args": ["--tasks", "classification"],
      "limit": 1,
      "ctx_size": 4096,
      "depends_on": ["knowledge_lane"]
    }
  ]
}
